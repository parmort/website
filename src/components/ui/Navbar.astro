---
import { Picture } from 'astro:assets'
import {profile} from '../../settings'
import SocialIcons from './SocialIcons.astro'
import Headshot from '@/assets/headshot.jpg'
import { getCollection } from 'astro:content'
import { template } from '@/settings'

const isBlogPopulated = await getCollection('blog').then(collection => collection.length > 0)

const {fullName, title} = profile
---
<aside
  class='overflow-auto px-4 pt-4 h-screen w-[20rem] bg-base-200 text-base-content flex flex-col'
>
  <div class='position-flex flex-col my-8 justify-between h-full'>
    <div>
      <div class='flex justify-center items-center flex-col'>
        <Picture
          class='mask mask-circle size-44'
          src={Headshot}
          formats={['webp']}
          alt={`Profile picture of ${fullName}`}
        />
        <h1 class="text-lg mt-8 hidden lg:block font-black">{fullName}</h1>
        <h2 class="text-gray-600 hidden lg:block">{title}</h2>
      </div>
      <div class='mx-4 mt-16'>
        <ul class='space-y-4 menu grow shrink menu-md overflow-y-auto'>
          <li>
            <a href={`${template.base}/`} class='text-lg'>Home</a>
          </li>
          <li>
            <a href={`${template.base}/bio`} class='text-lg'>Bio</a>
          </li>
          <li>
            <a href={`${template.base}/media`} class='text-lg'>Listen</a>
          </li>
          {isBlogPopulated && <li>
            <a href={`${template.base}/blog/1`} class='text-lg'>Blog</a>
          </li> }
        </ul>
      </div>
    </div>
    <div class='flex justify-center mx-4'>
      <SocialIcons />
    </div>
  </div>
</aside>
