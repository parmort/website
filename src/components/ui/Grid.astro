---
interface Props {
  gridTitle: string;
  gridItems: {
    group: string;
    position: string | null;
    description: string;
  }[];
}

const {gridTitle, gridItems} = Astro.props;
---
<h2 class="text-3xl font-bold mb-8">{gridTitle}</h2>
<div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-2 gap-6">
  {gridItems.map((item) => (
    <div class="p-6 rounded-lg text-base-content bg-base-200">
      <h3 class="text-xl font-semibold">{item.group}</h3>
      <h3 class="text-lg mb-3">{item.position}</h3>
      <p>{item.description}</p>
    </div>
  ))}
</div>
