---
import Layout from '../layouts/Layout.astro'

import { profile } from '@/settings'
import Headshot from '@/assets/headshot.jpg'
import Hero from '@/components/ui/Hero.astro'
import Grid from '@/components/ui/Grid.astro'
import ArticleList from '@/components/ui/ArticleList.astro'

const { fullName, title, description, positions } = profile
---

<Layout>
  <!-- Hero Section -->
  <section class='flex items-center gap-12 border-b pb-12 px-10'>
    <Hero
      fullName={fullName}
      title={title}
      blurb={description}
      profilePicture={Headshot}
    />
  </section>

  <!-- Research Areas -->
  <section class='py-12 border-b'>
    <Grid gridTitle='Positions' gridItems={positions} />
  </section>

  <!-- Recent Publications -->
  <!--<section class='py-12 border-t'>-->
  <!--  <ArticleList listTitle='Recent Publications' listItems={publications} />-->
  <!--</section>-->
</Layout>
